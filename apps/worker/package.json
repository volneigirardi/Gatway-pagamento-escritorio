{
  "name": "@saas/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background job worker deployable",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@saas/config": "workspace:*",
    "@saas/database": "workspace:*",
    "@saas/database-migrations": "workspace:*",
    "@saas/observability": "workspace:*",
    "bullmq": "5.41.9",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@saas/eslint-config": "workspace:*",
    "@saas/testing": "workspace:*",
    "@saas/typescript-config": "workspace:*",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "eslint": "10.8.1",
    "testcontainers": "10.24.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
