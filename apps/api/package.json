    "@saas/outbox": "workspace:*",
    "@saas/testing": "workspace:*",
    "@saas/typescript-config": "workspace:*",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "otpauth": "9.5.1",
    "testcontainers": "10.24.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
