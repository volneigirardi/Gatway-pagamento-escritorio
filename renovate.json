{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["every weekend"],
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["every weekend"]
  },
  "packageRules": [
    {
      "description": "Group all non-major backend framework updates for easier review",
      "matchPackageNames": ["@nestjs/**", "fastify", "@fastify/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "backend framework (minor/patch)"
    },
    {
      "description": "Group OpenTelemetry packages together",
      "matchPackageNames": ["@opentelemetry/**"],
      "groupName": "opentelemetry"
    },
    {
      "description": "Never auto-merge major version bumps; they always need manual review + an ADR if architectural",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-review-required"]
    },
    {
      "description": "Auto-merge patch updates to dev tooling once CI is green",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Docker base images: patch/minor only, reviewed manually (pinned by tag+digest policy)",
      "matchManagers": ["dockerfile", "docker-compose"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true
}
