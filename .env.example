# Environment
NODE_ENV=development
LOG_LEVEL=info

# API / Realtime / Worker / Scheduler
PORT=3000

# Comma-separated allowed origins. No wildcard in production.
CORS_ORIGINS=http://localhost:3004

# Request tracing
REQUEST_ID_HEADER=x-request-id
CORRELATION_ID_HEADER=x-correlation-id

# Trusted proxies (true/false)
TRUSTED_PROXIES=true

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/saas_admin
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT=30000

# Redis
REDIS_URL=redis://:password@localhost:6379
REDIS_MAX_RETRIES=3

# Security
JWT_SECRET=change-me-min-32-bytes-long-secret-key
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECRET=change-me-min-32-bytes-cookie-secret

# Password hashing
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Realtime
WS_PING_TIMEOUT_MS=20000
WS_PING_INTERVAL_MS=5000
WS_MAX_HTTP_BUFFER_SIZE=1000000

# Worker
WORKER_CONCURRENCY=10
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# OpenTelemetry (traces + metrics). Disabled by default; enable once a
# collector (e.g. otel-collector, Grafana Alloy) is reachable at the endpoint.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Backup encryption (AES-256-GCM). Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
BACKUP_DIR=./backups
