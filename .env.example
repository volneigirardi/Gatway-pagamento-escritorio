# Environment
NODE_ENV=development
LOG_LEVEL=info
ACME_EMAIL=replace-me@example.invalid

# API / Realtime / Worker / Scheduler
PORT=3000

# Comma-separated allowed origins. No wildcard in production.
CORS_ORIGINS=http://localhost:3004

# Request tracing
REQUEST_ID_HEADER=x-request-id
CORRELATION_ID_HEADER=x-correlation-id

# Trusted proxies (comma-separated proxy-addr ranges/CIDRs)
TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# PostgreSQL
DATABASE_URL=postgres://blupo_app:runtime-password@localhost:5432/saas_admin
MIGRATION_DATABASE_URL=postgres://blupo_migrator:migration-password@localhost:5432/saas_admin
TENANT_PROVISIONER_DATABASE_URL=postgres://blupo_provisioner:provisioner-password@localhost:5432/saas_admin
DATABASE_ADMIN_URL=postgres://postgres:admin-password@localhost:5432/saas_admin
APP_DATABASE_PASSWORD=change-me-runtime-min-32-characters
MIGRATION_DATABASE_PASSWORD=change-me-migrator-min-32-characters
PROVISIONER_DATABASE_PASSWORD=change-me-provisioner-min-32-characters
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5
DATABASE_TIMEOUT=30000
TENANT_POOL_CACHE_MAX=10
TENANT_DATABASE_POOL_MAX=1

# Redis
REDIS_URL=redis://:password@localhost:6379
REDIS_MAX_RETRIES=3

# Security
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
JWT_ISSUER=https://app.blupo.com.br
JWT_PLATFORM_AUDIENCE=blupo-platform
JWT_TENANT_AUDIENCE=blupo-tenant
JWT_KEY_ID=blupo-key-1
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECRET=change-me-min-32-bytes-cookie-secret
MFA_ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key

# Password hashing
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Realtime
WS_PING_TIMEOUT_MS=20000
WS_PING_INTERVAL_MS=5000
WS_MAX_HTTP_BUFFER_SIZE=1000000

# Worker
WORKER_CONCURRENCY=10
TENANT_PROVISIONING_CONCURRENCY=2
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# OpenTelemetry (traces + metrics). Disabled by default; enable once a
# collector (e.g. otel-collector, Grafana Alloy) is reachable at the endpoint.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Backup encryption (AES-256-GCM). Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
BACKUP_DIR=./backups
