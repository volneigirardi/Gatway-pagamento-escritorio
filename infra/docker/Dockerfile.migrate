FROM node:24.18.0-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate

FROM base AS deps
WORKDIR /app
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml nx.json ./
# pnpm --frozen-lockfile validates the whole workspace against pnpm-lock.yaml,
# so every workspace package.json must be present even though only
# @saas/database-migrations and its dependencies are actually installed below.
# node_modules/dist are stripped by .dockerignore.
COPY apps ./apps
COPY packages ./packages
COPY database ./database
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --filter @saas/database-migrations...

FROM base AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/database ./database
COPY . .
RUN pnpm exec nx run-many -t build -p @saas/database @saas/config

FROM node:24.18.0-alpine AS production
WORKDIR /app
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
COPY --from=build --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=build --chown=nodejs:nodejs /app/database ./database
COPY --from=build --chown=nodejs:nodejs /app/packages ./packages
WORKDIR /app/database
USER nodejs
ENV NODE_ENV=production
# Target defaults to "tenant"; pass "admin" as an extra arg to migrate the
# central catalog instead. This image migrates ONE database per run — the
# operator (or a wrapper Job/CronJob) is responsible for iterating tenants.
# See docs/database/migration-standards.md.
CMD ["node", "--experimental-strip-types", "scripts/run-migrations.ts", "up", "tenant"]
