FROM node:24.18.0-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate

FROM base AS deps
WORKDIR /app
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml nx.json ./
# pnpm --frozen-lockfile validates the whole workspace against pnpm-lock.yaml,
# so every workspace package.json must be present even though only
# @saas/worker and its dependencies are actually installed below.
# node_modules/dist are stripped by .dockerignore.
COPY apps ./apps
COPY packages ./packages
COPY database ./database
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --filter @saas/worker...

FROM base AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/packages ./packages
COPY . .
# Use Nx (not `pnpm --filter ... build`) so workspace dependencies are built
# first per the project graph — see Dockerfile.api for the full rationale.
RUN pnpm exec nx build @saas/worker

FROM node:24.18.0-alpine AS production
WORKDIR /app
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
# See Dockerfile.api for why the full node_modules/packages/app trees (not
# just dist + package.json) must be copied here.
COPY --from=build --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=build --chown=nodejs:nodejs /app/packages ./packages
COPY --from=build --chown=nodejs:nodejs /app/database ./database
COPY --from=build --chown=nodejs:nodejs /app/apps/worker ./apps/worker
USER nodejs
ENV NODE_ENV=production
WORKDIR /app/apps/worker
CMD ["node", "dist/main.js"]
