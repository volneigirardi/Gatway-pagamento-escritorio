# Templates only. Do NOT commit real values.
# Create these secrets out-of-band or manage them with an external secrets
# operator backed by Vault, AWS Secrets Manager, GCP Secret Manager, or equivalent.
apiVersion: v1
kind: Secret
metadata:
  name: saas-database-runtime-secrets
  namespace: saas
type: Opaque
stringData:
  DATABASE_URL: "postgres://blupo_app:REPLACE_ME@postgres:5432/saas_admin"
---
apiVersion: v1
kind: Secret
metadata:
  name: saas-redis-runtime-secrets
  namespace: saas
type: Opaque
stringData:
  REDIS_URL: "redis://REPLACE_ME"
---
apiVersion: v1
kind: Secret
metadata:
  name: saas-auth-signing-secrets
  namespace: saas
type: Opaque
stringData:
  JWT_PRIVATE_KEY: "REPLACE_WITH_PKCS8_PEM"
  COOKIE_SECRET: "REPLACE_ME_MIN_32_BYTES"
  MFA_ENCRYPTION_KEY: "REPLACE_WITH_BASE64_32_BYTE_KEY"
---
apiVersion: v1
kind: Secret
metadata:
  name: saas-jwt-verification-secrets
  namespace: saas
type: Opaque
stringData:
  JWT_PUBLIC_KEY: "REPLACE_WITH_SPKI_PEM"
---
apiVersion: v1
kind: Secret
metadata:
  name: saas-migration-secrets
  namespace: saas
type: Opaque
stringData:
  MIGRATION_DATABASE_URL: "postgres://blupo_migrator:REPLACE_ME@postgres:5432/saas_admin"
---
apiVersion: v1
kind: Secret
metadata:
  name: saas-provisioner-secrets
  namespace: saas
type: Opaque
stringData:
  TENANT_PROVISIONER_DATABASE_URL: "postgres://blupo_provisioner:REPLACE_ME@postgres:5432/saas_admin"
