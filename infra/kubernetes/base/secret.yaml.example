# Template only. Do NOT commit real values.
# Create the real secret out-of-band, e.g.:
#   kubectl create secret generic saas-secrets -n saas \
#     --from-literal=DATABASE_URL=postgres://... \
#     --from-literal=REDIS_URL=redis://... \
#     --from-literal=JWT_SECRET=$(openssl rand -base64 48) \
#     --from-literal=COOKIE_SECRET=$(openssl rand -base64 48)
# or manage via an external secret manager (Vault, AWS Secrets Manager, etc.)
# with the External Secrets Operator instead of committing Secret manifests.
apiVersion: v1
kind: Secret
metadata:
  name: saas-secrets
  namespace: saas
type: Opaque
stringData:
  DATABASE_URL: "postgres://REPLACE_ME"
  REDIS_URL: "redis://REPLACE_ME"
  JWT_SECRET: "REPLACE_ME_MIN_32_BYTES"
  COOKIE_SECRET: "REPLACE_ME_MIN_32_BYTES"
