{
  "name": "@saas/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design tokens",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "themes/*.json"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./themes/*": "./themes/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@saas/typescript-config": "workspace:*",
    "typescript": "5.9.3"
  }
}
