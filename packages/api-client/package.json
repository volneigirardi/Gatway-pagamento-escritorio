{
  "name": "@saas/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated typed API client",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "openapi-typescript http://localhost:3000/api/docs-json --output ./src/generated.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.15.2"
  },
  "devDependencies": {
    "@saas/typescript-config": "workspace:*",
    "openapi-typescript": "7.8.0",
    "typescript": "5.9.3"
  }
}
